# CCC Analyzer - Environment Configuration Example
# Copy this file to .env and modify values as needed

# ========================================
# APPLICATION ENVIRONMENT
# ========================================

# Environment mode: development, testing, production
ENVIRONMENT=development

# Debug mode (True/False)
DEBUG=True

# ========================================
# API CONFIGURATION
# ========================================

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# ========================================
# SCREENER.IN CONFIGURATION
# ========================================

# Screener.in base URL
SCREENER_BASE_URL=https://www.screener.in/api

# API timeout in seconds
SCREENER_TIMEOUT=10

# ========================================
# CORS CONFIGURATION
# ========================================

# Allowed origins for CORS (comma-separated)
# For local development:
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5000"]

# For production, replace with your domain:
# CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# ========================================
# AI INTEGRATION (FUTURE USE)
# ========================================

# Claude/OpenAI API Keys (not required for current version)
# Uncomment and add your keys when AI features are enabled

# ANTHROPIC_API_KEY=your_claude_api_key_here
# OPENAI_API_KEY=your_openai_key_here

# ========================================
# DATABASE CONFIGURATION (FUTURE)
# ========================================

# Uncomment when adding database support
# DATABASE_URL=postgresql://user:password@localhost/ccc_analyzer
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# ========================================
# CACHE CONFIGURATION (FUTURE)
# ========================================

# Uncomment when adding Redis cache
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# ========================================
# LOGGING CONFIGURATION
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
# LOG_FILE=logs/app.log

# ========================================
# SECURITY CONFIGURATION (PRODUCTION)
# ========================================

# JWT Secret (generate with: openssl rand -hex 32)
# JWT_SECRET=your_secret_key_here

# Session timeout in minutes
# SESSION_TIMEOUT=30

# CSRF protection enabled
# CSRF_ENABLED=True

# ========================================
# FRONTEND CONFIGURATION
# ========================================

# React app API URL
REACT_APP_API_URL=http://localhost:8000

# ========================================
# MISCELLANEOUS
# ========================================

# Application version
APP_VERSION=1.0.0

# ========================================
# NOTES
# ========================================
# - Development mode uses sample data when available
# - All paths should use forward slashes (/)
# - Boolean values should be: True, False, true, false, 1, 0
# - Port numbers should be integers without quotes
# - Keep sensitive data out of version control
